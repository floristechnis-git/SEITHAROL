<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark Mode Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Matches your dark background token (#101010) -->
        <item name="windowSplashScreenBackground">#101010</item>
        <!-- Your SVG/Vector Logo -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <!-- Theme to switch to once loaded -->
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
